// For format details, see https://aka.ms/devcontainer.json.
// Based on the andykenward/devcontainers-templates "dev" template (v2.0.0).
{
  "name": "Container - Unlike",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Named volumes survive container rebuilds.
  //  - Shared across every project with the same prefix: Claude Code login and
  //    settings, GitHub CLI login, git config (identity, commit signing).
  //  - Per project: mise tool installs, shell history and VS Code server
  //    extensions.
  "mounts": [
    "source=devcontainer-claude,target=/home/vscode/.claude,type=volume",
    "source=devcontainer-gh,target=/home/vscode/.config/gh,type=volume",
    "source=devcontainer-git,target=/home/vscode/.config/git,type=volume",
    "source=${devcontainerId}-mise,target=/home/vscode/.local/share/mise,type=volume",
    "source=${devcontainerId}-history,target=/commandhistory,type=volume",
    "source=${devcontainerId}-vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=volume"
  ],

  // Starship prompt config. Until the project adds .devcontainer/starship.toml
  // (start from a copy: cp ~/.config/starship.toml .devcontainer/), the image's
  // default is used. New terminals pick up changes without a rebuild.
  "containerEnv": {
    "DEVCONTAINER_STARSHIP_CONFIG": "${containerWorkspaceFolder}/.devcontainer/starship.toml"
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/mkcert:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "chat.disableAIFeatures": true
      }
    }
  },

  // devcontainer-post-create fixes volume ownership, runs `mise install` for
  // the project's tools and wires git up to gh credentials when logged in
  // (skipped when a forwarded SSH agent has a key, so git uses SSH instead).
  "postCreateCommand": {
    // Object entries run in parallel; pnpm needs the Node and pnpm that
    // devcontainer-post-create installs from mise.toml, so it runs after.
    "post-create": "devcontainer-post-create && mise exec -- pnpm i && mise exec -- pnpm exec playwright install --with-deps",
    "mkcert": "mkcert -install && mkcert -cert-file localhost+6.pem -key-file localhost+6-key.pem localhost 127.0.0.1 ::1"
  }
}
