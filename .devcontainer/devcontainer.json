// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Container - Unlike",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "24",
      "pnpmVersion": "11.22.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "extensions": "github/gh-stack"
    },
    "ghcr.io/devcontainers-extra/features/mkcert:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "postCreateCommand": {
    // Native installer (~/.local/bin) so Claude Code can auto-update without sudo.
    // One entry: object entries run in parallel, and the plugin installs need
    // claude and both write its plugin files.
    "claude": "curl -fsSL https://claude.ai/install.sh | bash && export PATH=\"$HOME/.local/bin:$PATH\" && claude plugin marketplace add anthropics/claude-plugins-official && claude plugin install mattpocock-skills@claude-plugins-official && claude plugin install ponytail --marketplace ./.claude/marketplace --scope project",
    "mkcert": "mkcert -install && mkcert localhost 127.0.0.1 ::1 -cert-file localhost.pem -key-file localhost-key.pem",
    "pnpm": "pnpm i && pnpm exec playwright install --with-deps"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // prek builds Python hooks (zizmor) with uv, which can't use the image's
    // python3-minimal; make uv download its own interpreter instead.
    "UV_PYTHON_PREFERENCE": "only-managed"
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=agents-${devcontainerId},target=/home/vscode/.agents,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=zsh-history-${devcontainerId},target=/home/vscode/.commandhistory,type=volume"
  ],
  "remoteUser": "vscode"
}
