// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Container - Unlike",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    // Node 24 matches CI (.github/actions/setup-pnpm); pnpm matches packageManager.
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24",
      "pnpmVersion": "10.12.4"
    },
    // Extensions install at image build as the remote user. The option can't
    // pin a version, so each rebuild pulls the extension's latest release.
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {
      "extensions": "github/gh-stack"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers-extra/features/mkcert:1": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": {
    "ohmyzsh": "sed -i '/^ZSH_THEME/c\\ZSH_THEME=\"bira\"' ~/.zshrc",
    "mkcert": "mkcert -install && mkcert localhost 127.0.0.1 ::1 -cert-file localhost.pem -key-file localhost-key.pem",
    "pnpm": "pnpm i && pnpm exec playwright install --with-deps"
  },

  "updateContentCommand": {
    "pnpm": "rm -rf .cache && pnpm i"
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ]
      // "mcp": {
      //   "servers": {
      //     "playwright": {
      //       "command": "pnpx",
      //       "args": ["@playwright/mcp"]
      //     }
      //   }
      // }
    }
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=zsh-history-${devcontainerId},target=/home/vscode/.commandhistory,type=volume"
  ],

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "vscode"
}
