{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ./.claude/scripts/stop-review-agents.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@unlike-dev": true,
    "ponytail@unlike-dev": true
  },
  "extraKnownMarketplaces": {
    "unlike-dev": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  },
  "outputStyle": "Concise"
}
