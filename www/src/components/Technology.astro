---
import { getCollection } from "astro:content";

const TAGS = await getCollection("tags").then((data) =>
  data
    .filter((item) => !item.id.startsWith("legacy/"))
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder),
);

// Display order of the folders under src/content/tags/.
const GROUPS = [
  "language",
  "react",
  "graphql",
  "framework",
  "platform",
  "css",
  "cms",
  "testing",
  "tool",
];

const group = (item: (typeof TAGS)[number]) => item.id.split("/")[0] ?? "";
const unknown = TAGS.filter((item) => !GROUPS.includes(group(item)));
if (unknown.length) {
  throw new Error(
    `Tag folders missing from GROUPS: ${unknown.map((item) => item.id).join(", ")}`,
  );
}

const ORDERED_TAGS = GROUPS.map((name) =>
  TAGS.filter((item) => group(item) === name),
);
---

<section>
  <h2 id="skills" class="mx-auto mb-5 text-left text-3xl font-normal">
    <a href="#skills">Skills:</a>
  </h2>
  <ul
    aria-labelledby="skills"
    class="mx-auto flex flex-wrap text-lg [&>li]:inline-flex [&>li]:after:mx-2 [&>li]:after:content-['•'] [&>li:last-child]:after:hidden"
  >
    {ORDERED_TAGS.map((tags) =>
      tags.map(({ data }) => (
        <li>
          <a
            class="text-lg underline decoration-transparent decoration-2 underline-offset-4 transition-[text-decoration-color] duration-150 ease-linear hover:decoration-current focus-visible:decoration-current md:text-xl"
            href={data.href}
            rel="noreferrer nofollow"
          >
            {data.title}
          </a>
        </li>
      )),
    )}
  </ul>
</section>
